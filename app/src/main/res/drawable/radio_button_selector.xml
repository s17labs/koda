<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/kodaLightBlue" />
                    <size android:width="24dp" android:height="24dp" />
                </shape>
            </item>
            <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/kodaDark" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kodaDark" />
            <stroke android:width="2dp" android:color="@color/kodaTextSecondary" />
            <size android:width="24dp" android:height="24dp" />
        </shape>
    </item>
</selector>

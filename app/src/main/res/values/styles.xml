<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/kodaDarkBlue</item>
        <item name="colorPrimaryDark">@color/kodaDark</item>
        <item name="colorAccent">@color/kodaLightBlue</item>
        <item name="android:windowBackground">@color/kodaEditorBg</item>
        <item name="android:statusBarColor">@color/kodaEditorBg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/kodaEditorBg</item>
        <item name="android:popupMenuStyle">@style/KodaPopupMenu</item>
        <item name="actionDropDownStyle">@style/KodaPopupMenu</item>
    </style>

    <style name="KodaPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@color/kodaDark</item>
    </style>
    <style name="KodaDialogButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:minWidth">100dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textColor">@color/kodaBlue</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">false</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:background">@drawable/btn_dialog_primary</item>
    </style>
    <style name="KodaDialogButton.Secondary" parent="KodaDialogButton">
        <item name="android:textColor">@color/kodaTextSecondary</item>
        <item name="android:textStyle">normal</item>
        <item name="android:background">@drawable/btn_dialog_secondary</item>
    </style>
</resources>
